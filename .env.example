# Django backend base URL (server-side only). The Next.js rewrite in
# next.config.mjs proxies /api/backend/* -> ${BACKEND_API_URL}/api/*
# so the browser stays same-origin (no CORS needed).
# Defaults to the deployed Railway backend; set this to run against a local one.
# BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_URL=https://projecthuntingbackendpython-production.up.railway.app

# Login gate for the /admin page (set in Vercel to enable protection).
# If ADMIN_PASSWORD is empty, the /admin gate is disabled (local dev).
# AUTH_SECRET signs the session cookie — set it to a long random string.
ADMIN_USER=admin
ADMIN_PASSWORD=
AUTH_SECRET=
